{
    "name": "nextjs-starter",
    "version": "8.0.0",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "analyze": "next experimental-analyze",
        "build": "next build",
        "build-storybook": "storybook build",
        "dev": "next dev --turbo",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "jscpd": "jscpd",
        "knip": "knip --strict",
        "lint": "oxlint",
        "lint-fix": "oxlint --fix",
        "prod": "next start",
        "storybook": "storybook dev -p 6006",
        "test": "vitest run",
        "test:component": "vitest run --project component",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:unit": "vitest run --project unit",
        "test:watch": "vitest",
        "tsc": "tsc --project tsconfig.json --noEmit --pretty",
        "verify": "npm run verify:fast && npm run knip && npm run jscpd && npm run test && npm run test:e2e",
        "verify:fast": "npm run fmt:check && npm run lint && npm run tsc"
    },
    "dependencies": {
        "@repo/api": "*",
        "@repo/core": "*",
        "@sentry/nextjs": "10.73.0",
        "@t3-oss/env-nextjs": "0.13.11",
        "@tanstack/react-query": "5.102.8",
        "@tanstack/react-query-next-experimental": "5.102.8",
        "@vercel/otel": "2.1.3",
        "adze": "2.3.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dayjs": "1.11.23",
        "framer-motion": "13.2.0",
        "lodash-es": "4.18.1",
        "lucide-react": "1.42.0",
        "nanoid": "6.0.1",
        "next": "16.3.4",
        "nuqs": "2.10.1",
        "prom-client": "15.1.3",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-use": "17.6.1",
        "server-only": "0.0.1",
        "tailwind-merge": "3.6.0",
        "tsafe": "1.8.12",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@playwright/test": "1.63.0",
        "@storybook/addon-a11y": "10.6.0",
        "@storybook/addon-designs": "11.1.4",
        "@storybook/addon-docs": "10.6.0",
        "@storybook/addon-links": "10.6.0",
        "@storybook/addon-onboarding": "10.6.0",
        "@storybook/addon-vitest": "10.6.0",
        "@storybook/nextjs-vite": "10.6.0",
        "@tailwindcss/postcss": "4.3.3",
        "@tailwindcss/typography": "0.5.20",
        "@tanstack/react-devtools": "0.10.12",
        "@tanstack/react-form-devtools": "0.2.34",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/lodash-es": "4.17.12",
        "@types/node": "26.5.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "@vitejs/plugin-react": "6.1.1",
        "@vitest/browser": "4.1.11",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-v8": "4.1.11",
        "@webpractik/oxlint-config": "https://github.com/webpractik/oxlint-config/releases/download/v1.0.3/webpractik-oxlint-config-1.0.3.tgz",
        "ajv": "8.20.0",
        "allure-js-commons": "3.12.0",
        "allure-vitest": "3.12.0",
        "babel-plugin-react-compiler": "1.0.0",
        "commitizen": "4.3.2",
        "cssnano": "9.0.4",
        "cz-conventional-changelog": "3.3.0",
        "eslint": "10.10.0",
        "eslint-plugin-better-tailwindcss": "4.7.0",
        "eslint-plugin-react-rsc": "5.19.0",
        "eslint-plugin-storybook": "10.6.0",
        "jscpd": "5.1.2",
        "knip": "6.34.0",
        "lefthook": "2.1.12",
        "oxfmt": "0.67.0",
        "oxlint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "playwright": "1.63.0",
        "postcss": "8.5.28",
        "shadcn": "4.21.0",
        "storybook": "10.6.0",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "type-fest": "5.9.0",
        "typed-query-selector": "2.12.2",
        "typescript": "7.0.2",
        "vite": "8.2.2",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "4.1.11",
        "vitest-browser-react": "2.3.0"
    },
    "overrides": {
        "@hey-api/json-schema-ref-parser": {
            "js-yaml": "4.3.1"
        },
        "storybook": "$storybook"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "browserslist": [
        "defaults",
        "not dead"
    ],
    "engines": {
        "node": "^24.15.0",
        "npm": "11.x"
    },
    "allowScripts": {
        "@sentry/cli@2.58.6": true,
        "lefthook@2.1.12": true,
        "sharp@0.34.5": true,
        "es5-ext@0.10.64": true,
        "esbuild@0.28.2": true
    },
    "trustedDependencies": [
        "@sentry/cli",
        "sharp"
    ]
}
