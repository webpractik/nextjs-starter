{
    "name": "nextjs-starter",
    "version": "8.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "analyze": "next experimental-analyze",
        "api:bundle": "cd src/api && redocly bundle openapi/openapi.yaml -o bundled.yaml",
        "api:gen": "npm run api:lint:openapi && npm run api:bundle && npm run api:generate:client && npm run api:generate:helpers && oxfmt src/api/codegen && oxfmt src/api/codegen && npm run tsc",
        "api:gen:check": "tsx src/api/generators/check-generated.ts",
        "api:generate:client": "cd src/api && kubb generate",
        "api:generate:helpers": "cd src/api && tsx generators/run-post-generate.ts",
        "api:lint:openapi": "cd src/api && redocly lint",
        "api:test": "vitest run --project unit tests/unit/src/api",
        "build": "next build",
        "build-storybook": "storybook build",
        "check:imports": "node tools/check-imports.mjs",
        "check:structure": "node tools/check-structure.mjs",
        "dev": "next dev --turbo",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "jscpd": "jscpd",
        "knip": "node --env-file-if-exists=.env node_modules/knip/bin/knip.js",
        "lint": "oxlint",
        "lint-fix": "oxlint --fix",
        "prod": "next start",
        "storybook": "storybook dev -p 6006",
        "test": "vitest run",
        "test:component": "vitest run --project component",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:production": "node tools/test-production-prefetch.mjs",
        "test:unit": "vitest run --project unit",
        "test:watch": "vitest",
        "tsc": "tsc --project tsconfig.json --noEmit --pretty",
        "verify": "npm run verify:fast && npm run knip && npm run jscpd && npm run test && npm run test:e2e",
        "verify:fast": "npm run check:structure && npm run check:imports && npm run fmt:check && npm run lint && npm run tsc"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@faker-js/faker": "10.6.0",
        "@foresightjs/react": "1.0.0",
        "@maskito/core": "5.6.1",
        "@maskito/kit": "5.6.1",
        "@maskito/phone": "5.6.1",
        "@maskito/react": "5.6.1",
        "@opentelemetry/api": "1.9.1",
        "@opentelemetry/api-logs": "0.223.0",
        "@opentelemetry/instrumentation": "0.223.2",
        "@opentelemetry/resources": "2.12.1",
        "@opentelemetry/sdk-logs": "0.223.2",
        "@opentelemetry/sdk-metrics": "2.12.1",
        "@opentelemetry/sdk-trace-base": "2.12.1",
        "@sentry/nextjs": "11.12.0",
        "@t3-oss/env-nextjs": "0.13.11",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.107.1",
        "@tanstack/react-query-next-experimental": "5.107.1",
        "@vercel/otel": "2.3.0",
        "adze": "2.3.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "framer-motion": "14.14.0",
        "isomorphic-dompurify": "4.7.0",
        "js.foresight": "4.2.1",
        "libphonenumber-js": "1.13.16",
        "lodash-es": "4.18.1",
        "lucide-react": "1.73.0",
        "nanoid": "6.0.2",
        "next": "16.4.6",
        "nuqs": "2.10.3",
        "prom-client": "15.1.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-use": "17.6.1",
        "server-only": "0.0.1",
        "tailwind-merge": "3.7.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@kubb/adapter-oas": "5.20.2",
        "@kubb/plugin-client": "6.0.4",
        "@kubb/plugin-faker": "5.4.5",
        "@kubb/plugin-ts": "5.5.4",
        "@kubb/plugin-zod": "5.9.4",
        "@playwright/test": "1.65.1",
        "@redocly/cli": "2.79.0",
        "@storybook/addon-a11y": "10.6.7",
        "@storybook/addon-designs": "12.0.0",
        "@storybook/addon-docs": "10.6.7",
        "@storybook/addon-vitest": "10.6.7",
        "@storybook/nextjs-vite": "10.6.7",
        "@storybook/react": "10.6.7",
        "@tailwindcss/postcss": "4.3.5",
        "@tailwindcss/typography": "0.5.20",
        "@tanstack/react-devtools": "0.10.14",
        "@tanstack/react-form-devtools": "0.2.34",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/lodash-es": "4.17.12",
        "@types/node": "26.6.6",
        "@types/pluralize": "0.0.33",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "@vitest/browser": "5.1.0",
        "@vitest/browser-playwright": "5.1.0",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/runner": "4.1.11",
        "@webpractik/oxlint-config": "https://github.com/webpractik/oxlint-config/releases/download/v1.0.4/webpractik-oxlint-config-1.0.4.tgz",
        "allure-js-commons": "3.14.0",
        "allure-vitest": "3.14.0",
        "babel-plugin-react-compiler": "1.0.0",
        "change-case": "5.4.4",
        "commitizen": "4.3.2",
        "cssnano": "9.9.0",
        "cz-conventional-changelog": "3.3.0",
        "deepmerge": "npm:@shivammathur/deepmerge@4.3.2",
        "eslint": "10.15.0",
        "eslint-plugin-better-tailwindcss": "4.11.0",
        "eslint-plugin-react-rsc": "5.30.3",
        "eslint-plugin-storybook": "10.6.7",
        "jscpd": "5.4.3",
        "knip": "6.45.1",
        "kubb": "5.20.2",
        "lefthook": "2.2.2",
        "oxc-parser": "0.152.0",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-plugin-react-doctor": "0.9.23",
        "oxlint-tsgolint": "7.0.2007",
        "playwright": "1.65.1",
        "pluralize": "8.0.0",
        "postcss": "8.5.33",
        "shadcn": "4.23.0",
        "storybook": "10.6.7",
        "tailwindcss": "4.3.5",
        "tsx": "4.23.15",
        "tw-animate-css": "1.4.0",
        "typed-query-selector": "2.12.4",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "5.1.0",
        "vitest-browser-react": "2.3.0",
        "yaml": "2.9.1"
    },
    "overrides": {
        "adze": {
            "@ungap/structured-clone": "1.4.0"
        },
        "deepmerge": "$deepmerge",
        "glob@>=9.0.0 <=14.0.1": "14.0.6",
        "minimatch@>=7.0.0 <11.0.1": "11.0.8",
        "postcss-selector-parser": "7.2.1",
        "sharp": "0.35.5",
        "storybook": "$storybook"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "browserslist": [
        "defaults",
        "not dead"
    ],
    "engines": {
        "node": "^26.13.1",
        "npm": "11.x"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "lefthook@2.2.2": true,
        "sharp@0.35.5": true
    },
    "trustedDependencies": [
        "sharp"
    ]
}
