{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "tags": ["-lintignore"],
    "ignore": [
        "packages/api/**",
        "instrumentation-client.js",
        "vitest.config.ts",
        "vitest.setup.ts"
    ],
    "workspaces": {
        ".": {
            "ignoreDependencies": [
                "@tanstack/react-devtools",
                "@tanstack/react-form-devtools",
                "shadcn"
            ],
            "vitest": {
                "config": []
            }
        },
        "packages/core": {
            "ignoreDependencies": [
                "@maskito/core",
                "@maskito/kit",
                "@maskito/phone",
                "@maskito/react",
                "@tanstack/react-form",
                "libphonenumber-js"
            ],
            "ignoreFiles": ["form/**", "slider/**"]
        }
    }
}
