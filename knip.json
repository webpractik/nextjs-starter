{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "tags": ["-lintignore"],
    "ignore": [
        "packages/api/**",
        "instrumentation-client.js",
        "vitest.config.ts",
        "vitest.setup.ts"
    ],
    "workspaces": {
        ".": {
            "ignoreDependencies": ["@tanstack/react-devtools", "@tanstack/react-form-devtools"],
            "vitest": {
                "config": []
            }
        },
        "packages/core": {
            "ignoreDependencies": ["@tanstack/react-form"],
            "ignoreFiles": ["form/**", "slider/**"]
        }
    }
}
