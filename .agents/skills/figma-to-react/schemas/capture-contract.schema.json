{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.com/schemas/figma-to-react/capture-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "filesystemId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!\\s)(?!.*\\s$)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
    },
    "nullableProjectRelativePath": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!\\s)(?!.*\\s$)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
    },
    "fileKey": {
      "type": "string",
      "minLength": 6,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "fileVersion": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "nullableLogicalDimensions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "dpr"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "dpr": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "captureRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "logicalDimensions", "pixelRounding"],
      "properties": {
        "kind": { "enum": ["viewport", "full-page", "selector"] },
        "selector": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "logicalDimensions": { "$ref": "#/$defs/nullableLogicalDimensions" },
        "pixelRounding": { "type": ["string", "null"], "enum": ["floor", "ceil", "round", null] }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colorScheme", "reducedMotion", "scrollbarPolicy"],
      "properties": {
        "colorScheme": { "enum": ["light", "dark"] },
        "reducedMotion": { "enum": ["reduce", "no-preference"] },
        "scrollbarPolicy": { "enum": ["visible", "hidden", "stable"] }
      }
    },
    "versionedRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "container": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["image", "digest"],
      "properties": {
        "image": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/checksum" }
      }
    },
    "fontHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "style", "weight", "hash"],
      "properties": {
        "family": { "$ref": "#/$defs/nonEmptyString" },
        "style": { "$ref": "#/$defs/nonEmptyString" },
        "weight": {
          "type": ["integer", "string"],
          "minimum": 1,
          "minLength": 1
        },
        "hash": { "$ref": "#/$defs/checksum" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "os", "container", "headless", "fontHashes"],
      "properties": {
        "browser": { "$ref": "#/$defs/versionedRuntime" },
        "os": { "$ref": "#/$defs/versionedRuntime" },
        "container": { "$ref": "#/$defs/container" },
        "headless": { "type": "boolean" },
        "fontHashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fontHash" }
        }
      }
    },
    "reference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sourceId", "path", "checksum", "dimensions"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/filesystemId" },
        "path": { "$ref": "#/$defs/projectRelativePath" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "dimensions": { "$ref": "#/$defs/dimensions" }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryLayout", "dynamicText", "visibility"],
      "properties": {
        "primaryLayout": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "dynamicText": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "visibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "readinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "expected"],
      "properties": {
        "kind": {
          "enum": [
            "url-equals",
            "selector-visible",
            "selector-hidden",
            "text-present",
            "fonts-ready",
            "images-ready"
          ]
        },
        "selector": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "taskId",
        "fileKey",
        "nodeId",
        "fileVersion",
        "route",
        "captureRegion",
        "viewport",
        "state",
        "fixture",
        "locale",
        "timezone",
        "rendering",
        "environment",
        "comparatorProfile",
        "readiness",
        "reference",
        "evidencePath",
        "selectors",
        "evidenceMode"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/filesystemId" },
        "taskId": { "$ref": "#/$defs/filesystemId" },
        "fileKey": { "$ref": "#/$defs/fileKey" },
        "nodeId": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "fileVersion": { "$ref": "#/$defs/fileVersion" },
        "route": {
          "type": "string",
          "pattern": "^/(?!/)(?!.*[\\\\?#])[^\\r\\n\\u2028\\u2029\\u0000]*$",
          "minLength": 1
        },
        "captureRegion": { "$ref": "#/$defs/captureRegion" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "state": { "$ref": "#/$defs/filesystemId" },
        "fixture": { "$ref": "#/$defs/projectRelativePath" },
        "locale": { "$ref": "#/$defs/nonEmptyString" },
        "timezone": { "$ref": "#/$defs/nonEmptyString" },
        "rendering": { "$ref": "#/$defs/rendering" },
        "environment": { "$ref": "#/$defs/environment" },
        "comparatorProfile": { "const": "rgba-exact-v1" },
        "readiness": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/readinessCheck" }
        },
        "reference": { "$ref": "#/$defs/reference" },
        "evidencePath": { "$ref": "#/$defs/nullableProjectRelativePath" },
        "selectors": { "$ref": "#/$defs/selectors" },
        "evidenceMode": {
          "enum": ["visual-reference", "behavior-only", "responsive-only"]
        }
      }
    }
  }
}
