{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.com/schemas/figma-to-react/design-context-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "fileKey", "fileVersion", "rootNodeId", "requests"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "taskId": { "$ref": "#/$defs/filesystemId" },
    "fileKey": { "$ref": "#/$defs/fileKey" },
    "fileVersion": { "type": ["string", "null"], "minLength": 1, "pattern": "\\S" },
    "rootNodeId": { "$ref": "#/$defs/nodeId" },
    "requests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "filesystemId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "fileKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{6,}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!\\s)(?!.*\\s$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "operation",
        "responseFormat",
        "nodeId",
        "path",
        "checksum"
      ],
      "properties": {
        "requestId": { "$ref": "#/$defs/filesystemId" },
        "operation": {
          "enum": [
            "get_design_context",
            "get_metadata",
            "get_screenshot",
            "get_variable_defs",
            "download_assets",
            "get_code_connect_map"
          ]
        },
        "responseFormat": {
          "enum": ["text", "xml", "png", "json"]
        },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "path": { "$ref": "#/$defs/relativePath" },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    }
  }
}
