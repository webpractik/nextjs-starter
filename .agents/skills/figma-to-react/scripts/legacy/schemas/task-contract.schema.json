{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.com/schemas/figma-to-react/task-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "profile",
    "source",
    "target",
    "scope",
    "viewports",
    "states",
    "data",
    "provisioning",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "$ref": "#/$defs/filesystemId" },
    "profile": { "const": "strict-internal" },
    "source": { "$ref": "#/$defs/source" },
    "target": { "$ref": "#/$defs/target" },
    "scope": { "$ref": "#/$defs/scope" },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/viewport" }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/state" }
    },
    "data": { "$ref": "#/$defs/data" },
    "provisioning": { "$ref": "#/$defs/provisioning" },
    "acceptance": { "$ref": "#/$defs/acceptance" }
  },
  "$defs": {
    "filesystemId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaUrl", "nodeId"],
      "properties": {
        "figmaUrl": { "$ref": "#/$defs/nonEmptyString" },
        "nodeId": {
          "type": "string",
          "pattern": "^[0-9]+(?::|-)[0-9]+$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "featureModule"],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^/",
          "minLength": 1
        },
        "featureModule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "dpr"],
      "properties": {
        "id": { "$ref": "#/$defs/filesystemId" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "dpr": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicability", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/filesystemId" },
        "applicability": {
          "enum": ["required", "not-applicable"]
        },
        "evidence": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture"],
      "properties": {
        "fixture": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "capability": {
      "enum": ["available", "in-scope", "not-required"]
    },
    "requiredCapability": {
      "enum": ["available", "in-scope"]
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetMaterialization",
        "recharts",
        "agentBrowser",
        "visualCapture",
        "visualCompare",
        "vitestBrowser",
        "playwright",
        "agentVerify"
      ],
      "properties": {
        "assetMaterialization": { "$ref": "#/$defs/requiredCapability" },
        "recharts": { "$ref": "#/$defs/capability" },
        "agentBrowser": { "$ref": "#/$defs/requiredCapability" },
        "visualCapture": { "$ref": "#/$defs/requiredCapability" },
        "visualCompare": { "$ref": "#/$defs/requiredCapability" },
        "vitestBrowser": { "$ref": "#/$defs/requiredCapability" },
        "playwright": { "$ref": "#/$defs/requiredCapability" },
        "agentVerify": { "$ref": "#/$defs/requiredCapability" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualityGates",
        "comparatorProfile",
        "maxDifferenceRatio",
        "requireEightCategoryAnalysis",
        "requireProjectChecks"
      ],
      "properties": {
        "qualityGates": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6"]
          }
        },
        "comparatorProfile": { "const": "rgba-exact-v1" },
        "maxDifferenceRatio": { "const": 15 },
        "requireEightCategoryAnalysis": { "const": true },
        "requireProjectChecks": { "const": true }
      }
    }
  }
}
