# server
APP_NAME=nextjs_starter
APP_ENV=LOCAL
FRONT_HOST=nextjs-starter.127.0.0.1.nip.io
PORT=3000
# When a Compose container calls a backend on the Docker host, use http://host.docker.internal:8080
BACK_INTERNAL_URL=http://localhost:8080
CACHE_PROBE_ENABLED=false
# Set only in the isolated cache probe test overlay (minimum 32 characters)
CACHE_PROBE_TOKEN=
HTTP_AUTH_LOGIN=demo
HTTP_AUTH_PASS=demo
MOCK_MODE=false
SENTRY_DSN=https://public@example.invalid/1
SENTRY_AUTH_TOKEN=replace-me
SENTRY_ORG=example
SENTRY_URL=https://sentry.example.invalid
VALKEY_URL=redis://valkey:6379
VALKEY_CACHE_NAMESPACE=nextjs-starter:local:v1
VALKEY_CACHE_MAX_TTL_SECONDS=86400
VALKEY_CACHE_MAX_ENTRY_BYTES=1048576
CI=false

# Docker Compose gateway (not consumed by the application schemas)
FRONT_BIND_ADDRESS=127.0.0.1
FRONT_PORT=3000
VALKEY_MAXMEMORY=128mb
VALKEY_MEMORY_LIMIT=192m

# client
NEXT_PUBLIC_APP_ENV=LOCAL
NEXT_PUBLIC_FRONT_URL=http://nextjs-starter.127.0.0.1.nip.io:3000
NEXT_PUBLIC_BFF_PATH=/bff-api
NEXT_PUBLIC_BACK_URL=http://localhost:8080
NEXT_PUBLIC_MOCK_MODE=false
NEXT_PUBLIC_SENTRY_DSN=https://public@example.invalid/1
